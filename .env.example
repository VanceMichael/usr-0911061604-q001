# 服务端口
HTTP_PORT=8080

# PostgreSQL 连接串（索引与校验摘要落库）
DATABASE_URL=postgres://app:app@localhost:5432/kitchen?sslmode=disable

# Redis（异步通知 Streams）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=clip.events
REDIS_CONSUMER_GROUP=clip-indexer
ENABLE_STREAM_CONSUMER=true

# 设备时钟校验：occurred_at 允许超前服务端的最大值
CLOCK_DRIFT_TOLERANCE=5m
# 断线重传允许回补的最大事件年龄
MAX_BACKFILL_AGE=168h

# 优雅退出超时
SHUTDOWN_TIMEOUT=10s
